{
  "$comment": "Known-safe patterns for waap-help-center. Adapted from waap-docs.",
  "allowedUsagePatterns": {
    "components/posthog-provider.tsx": [
      "window"
    ],
    "components/structured-data.tsx": [
      "document"
    ]
  },
  "falsePositivePatterns": [],
  "allowedJsDirectories": [
    "components/",
    "lib/",
    "app/",
    ".github/scripts/"
  ],
  "knownMdxImportSources": [
    "nextra/components",
    "@/components/",
    "@/lib/"
  ],
